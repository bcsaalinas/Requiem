{
  "mcpServers": {
    "godot": {
      "command": "/opt/homebrew/bin/node",
      "args": [
        "/opt/homebrew/lib/node_modules/@letsagents/godot-mcp/server.js"
      ],
      "env": {
        "GODOT_MCP_BRIDGE_PORT": "6510",
        "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
      }
    }
  }
}
