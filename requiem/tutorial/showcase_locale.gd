## Adds the Spanish table (once) and switches the game to the showcase language.
static func install() -> void:
	if not _installed:
		var table := Translation.new()
		table.locale = "es"
		for key: String in ES:
			table.add_message(key, ES[key])
		TranslationServer.add_translation(table)
		_installed = true
	TranslationServer.set_locale(Showcase.LOCALE)


## F9 at the booth: Spanish <-> English, for a visitor who would rather read English.
static func toggle() -> void:
	TranslationServer.set_locale("en" if TranslationServer.get_locale().begins_with("es") else "es")
